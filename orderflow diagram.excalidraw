    {
      "id": "wkisxsc2Wtyx4grIj9aNK",
      "type": "text",
      "x": -237.27033875135567,
      "y": -647.6605926865288,
      "width": 741.1996459960938,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 326409365,
      "version": 211,
      "versionNonce": 531789851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792669083473,
      "created": 1792667530346,
      "link": null,
      "locked": false,
      "text": "Estimation (assume 10M DAU):\n\nOrders: 1M/day ÷ 86,400 s ≈ ~12 writes/s avg, about ~120 WPS at peak\n(10x).\n\nReads (status/history): 10:1 read:write, so ~1,200 RPS at peak.\n\nChatbot: 5% of DAU × 3 msgs = 1.5M/day, so ~20 RPS avg, ~200 at peak.\n\nOrder row: ~1 KB (with items), giving ~1 GB/day.\n\nYearly storage: ~365 GB/yr, so ~1.1 TB for 3 years, ~3.3 TB with 3x\nreplication.\n\nCache: 20% hot orders × 1 KB, so ~2 GB in Redis.\n\nBandwidth: 1,200 RPS × 1 KB ≈ ~1.2 MB/s egress.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Kw3BzaSo3qabYsVZc-FKB",
      "originalText": "Estimation (assume 10M DAU):\n\nOrders: 1M/day ÷ 86,400 s ≈ ~12 writes/s avg, about ~120 WPS at peak (10x).\n\nReads (status/history): 10:1 read:write, so ~1,200 RPS at peak.\n\nChatbot: 5% of DAU × 3 msgs = 1.5M/day, so ~20 RPS avg, ~200 at peak.\n\nOrder row: ~1 KB (with items), giving ~1 GB/day.\n\nYearly storage: ~365 GB/yr, so ~1.1 TB for 3 years, ~3.3 TB with 3x replication.\n\nCache: 20% hot orders × 1 KB, so ~2 GB in Redis.\n\nBandwidth: 1,200 RPS × 1 KB ≈ ~1.2 MB/s egress.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
